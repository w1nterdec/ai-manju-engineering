  "beats": [
    {
      "id": "B001",
      "summary": "单行舟拿起桌上的密封信封，询问来源。",
      "required_facts": [
        "桌上只有一个密封信封。",
        "信封由桌面移动到单行舟右手。"
      ],
      "lines": [
        {
          "id": "L001",
          "speaker_id": "C001",
          "text": "乐知遥，这封信是你放的？"
        }
      ]
    },
    {
      "id": "B002",
      "summary": "乐知遥阻止拆信，指出信封的日期。",
      "required_facts": [
        "乐知遥要求保持封口。",
        "信封署期为明天；日期文字由后期叠加。"
      ],
      "lines": [
        {
          "id": "L002",
          "speaker_id": "C002",
          "text": "单行舟，别拆。上面是明天的日期。"
        }
      ]
    },
    {
      "id": "B003",
      "summary": "静止的挂钟成为第二个异常线索。",
      "required_facts": [
        "挂钟停在二十三点五十九分。",
        "信封仍然没有被拆开。"
      ],
      "lines": [
        {
          "id": "L003",
          "speaker_id": "C001",
          "text": "钟停在十一点五十九分。"
        }
      ]
    },
    {
      "id": "B004",
      "summary": "乐知遥提及门外的人，两人看向关闭的门。",
      "required_facts": [
        "两人看向同一扇关闭的门。",
        "门外的人尚未露面，不能新增可见人物。"
      ],
      "lines": [
        {
          "id": "L004",
          "speaker_id": "C002",
          "text": "门外那个人，刚才也叫了你的名字。"
        }
      ]
    }
  ],
